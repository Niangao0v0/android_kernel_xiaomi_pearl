# Yuechu MT6895 product configuration
CONFIG_LOCALVERSION="-yuechu"

# Camera
CONFIG_CUSTOM_KERNEL_IMGSENSOR="yuechuimx355_mipi_raw yuechus5kgd2_mipi_raw yuechugc02m1_mipi_raw yuechuov02b10_mipi_raw yuechuimx800_mipi_raw yuechus5kgd2aux_mipi_raw"

# Charger
CONFIG_MTK_PUMP_EXPRESS_PLUS_SUPPORT=m
CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT=m
CONFIG_MTK_PUMP_EXPRESS_40_SUPPORT=m
CONFIG_GAUGE_MT6375=m
CONFIG_REGULATOR_WL2868C=m
CONFIG_XMEXT_SC8551A_CHG_PUMP=m

# Display
CONFIG_DRM_PANEL_M9_42_02_0A_DSC_CMD=m

# Fingerprint
CONFIG_MTK_FINGERPRINT_SUPPORT=m
CONFIG_GOODIX_MITEE_FINGERPRINT=m

# Product
CONFIG_BUILD_PRODUCT_NAME="yuechu"
CONFIG_TARGET_PRODUCT_yuechu=y
CONFIG_TARGET_PRODUCT_YUECHU=y

# Sound
CONFIG_SND_SMARTPA_AW882XX=m
CONFIG_MTK_VOW_BARGE_IN_SUPPORT=y
CONFIG_MTK_VOW_DUAL_MIC_SUPPORT=y
CONFIG_MTK_VOW_MAX_PDK_NUMBER=2
CONFIG_MTK_VOW_AMAZON_SUPPORT=n
CONFIG_MTK_VOW_GVA_SUPPORT=n
CONFIG_MTK_VOW_PCMCALLBACK_SUPPORT=n

# Tee
CONFIG_MITEE_SUPPORT=m

# Touchscreen
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_S3907_M9=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_CORE=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_REFLASH=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TESTING=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DEVICE=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DIAGNOSTIC=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# Vibrator
CONFIG_INPUT_AW8624_HAPTIC=m
